{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "routes": [
    {"src":"/(.*)","headers":{"X-Content-Type-Options":"nosniff","Referrer-Policy":"strict-origin-when-cross-origin"},"continue":true},
    {"src":"/","has":[{"type":"host","value":"(?<requestedHost>.*)"}],"dest":"/api/workspace?requestedHost=$requestedHost"},
    {"src":"/template","dest":"/template.html"},
    {"src":"/login","dest":"/login.html"},
    {"handle":"filesystem"}
  ]
}
